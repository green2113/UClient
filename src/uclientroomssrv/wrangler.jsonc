{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "uclient-rooms-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uclient-rooms",
			"database_id": "263c3209-ee3f-45f8-ac6d-b8bff8cc5638",
			"migrations_dir": "migrations"
		},
		{
			"binding": "uclient_rooms",
			"database_name": "uclient-rooms",
			"database_id": "263c3209-ee3f-45f8-ac6d-b8bff8cc5638"
		}
	],
	"r2_buckets": [
		{
			"binding": "CFG_BACKUPS",
			"bucket_name": "uclient-cfg-backups"
		}
	],
	"vars": {
		"ENVIRONMENT": "development",
		"RELAY_INVALIDATE_URL": "",
		"BEDROCK_REGION": "us-east-1",
		"BEDROCK_ENDPOINT": "runtime",
		"BEDROCK_MODEL_ID": "openai.gpt-oss-120b-1:0",
		"RESEND_FROM": "UClient <noreply@uclient.app>"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"placement": {
		"region": "aws:us-east-1"
	}
}

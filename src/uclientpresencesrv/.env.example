UDP_BIND=0.0.0.0:8778
WEB_HOST=127.0.0.1
WEB_PORT=8780
STATE_DIR=run/uclientpresencesrv
JSON_PATH=run/uclientpresencesrv/presence.json
TOKEN_PATH=run/uclientpresencesrv/shared-token.txt
# TLS is optional. Leave TLS_CERT_FILE/TLS_KEY_FILE empty to serve plain HTTP
# (recommended when running behind a Cloudflare Tunnel that terminates TLS).
# Set both to enable direct HTTPS serving with your own certificate.
TLS_CERT_FILE=
TLS_KEY_FILE=
UC_PRESENCE_UDP_SHARED_TOKEN=

# Optional legacy Cloudflare KV sync. Leave empty to use JSON snapshot mode only.
PRESENCE_SYNC_URL=
PRESENCE_UDP_SYNC_SECRET=
HEARTBEAT_SYNC_DEBOUNCE_SEC=60
